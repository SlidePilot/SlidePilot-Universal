{
  "sourceLanguage" : "en",
  "strings" : {
    "Connect a display, or start Screen Mirroring in Control Center." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schließe einen Bildschirm an oder starte „Bildschirmsynchronisierung“ im Kontrollzentrum." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez un écran ou lancez « Recopie de l’écran » dans le centre de contrôle." } }
      }
    },
    "Connected" : {
      "comment" : "Accessibility value of the external display button",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbunden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecté" } }
      }
    },
    "Current slide, %lld of %lld" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktuelle Folie, %1$lld von %2$lld" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive actuelle, %1$lld sur %2$lld" } }
      }
    },
    "End of presentation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ende der Präsentation" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fin de la présentation" } }
      }
    },
    "External Display" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Externer Bildschirm" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écran externe" } }
      }
    },
    "Go Back" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurück" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revenir" } }
      }
    },
    "Go back to the previously viewed slide" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zur zuletzt gezeigten Folie zurückkehren" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revenir à la dernière diapositive affichée" } }
      }
    },
    "Next Slide" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nächste Folie" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive suivante" } }
      }
    },
    "Next slide, %lld of %lld" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nächste Folie, %1$lld von %2$lld" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive suivante, %1$lld sur %2$lld" } }
      }
    },
    "Next slide: end of presentation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nächste Folie: Ende der Präsentation" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive suivante : fin de la présentation" } }
      }
    },
    "Not connected" : {
      "comment" : "Accessibility value of the external display button",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht verbunden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Non connecté" } }
      }
    },
    "Present on a second screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf einem zweiten Bildschirm präsentieren" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Présenter sur un second écran" } }
      }
    },
    "Presentation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Präsentation" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Présentation" } }
      }
    },
    "Presentation, slide %lld of %lld" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Präsentation, Folie %1$lld von %2$lld" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Présentation, diapositive %1$lld sur %2$lld" } }
      }
    },
    "Previous Slide" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorherige Folie" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive précédente" } }
      }
    },
    "Ready to present" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bereit zum Präsentieren" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Prêt à présenter" } }
      }
    },
    "Show the presentation in full screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Präsentation im Vollbildmodus zeigen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher la présentation en plein écran" } }
      }
    },
    "Start Presentation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Präsentation starten" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Démarrer la présentation" } }
      }
    },
    "The document “%@” could not be opened." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Dokument „%@“ konnte nicht geöffnet werden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le document « %@ » n’a pas pu être ouvert." } }
      }
    },
    "The document could not be opened." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Dokument konnte nicht geöffnet werden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le document n’a pas pu être ouvert." } }
      }
    },
    "The file is damaged or is not a PDF document." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei ist beschädigt oder kein PDF-Dokument." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le fichier est endommagé ou n’est pas un document PDF." } }
      }
    },
    "The PDF does not contain any pages." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das PDF enthält keine Seiten." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le PDF ne contient aucune page." } }
      }
    },
    "The PDF is protected with a password. Remove the password and open it again." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das PDF ist mit einem Passwort geschützt. Entferne das Passwort und öffne es erneut." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le PDF est protégé par un mot de passe. Supprimez le mot de passe et ouvrez-le à nouveau." } }
      }
    },
    "The presentation is shown on the external display." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Präsentation wird auf dem externen Bildschirm gezeigt." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La présentation est affichée sur l’écran externe." } }
      }
    }
  },
  "version" : "1.0"
}
