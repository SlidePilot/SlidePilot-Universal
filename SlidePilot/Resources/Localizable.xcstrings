{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, stopped" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "%@, gestoppt" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@, arrêté" } }
      }
    },
    "A PDF named “%@” with the same number of pages can no longer be found. You can use its stored data for this PDF." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein PDF namens „%@“ mit derselben Seitenzahl wird nicht mehr gefunden. Du kannst seine gespeicherten Daten für dieses PDF verwenden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un PDF nommé « %@ » avec le même nombre de pages est introuvable. Vous pouvez utiliser ses données enregistrées pour ce PDF." } }
      }
    },
    "Allow Access" : {
      "comment" : "Confirm button of the folder picker that grants access to the PDF's folder",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zugriff erlauben" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser l’accès" } }
      }
    },
    "Allow Access to Play Video…" : {
      "comment" : "Button over a video on the current slide when the PDF's folder is not accessible",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zugriff zum Abspielen erlauben …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser l’accès pour lire la vidéo…" } }
      }
    },
    "Allow Access to the Folder?" : {
      "comment" : "Title of the alert that asks for access to the PDF's folder (videos and run: links)",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zugriff auf den Ordner erlauben?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser l’accès au dossier ?" } }
      }
    },
    "Allow Access…" : {
      "comment" : "Alert button that opens the folder picker for the PDF's folder",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zugriff erlauben …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser l’accès…" } }
      }
    },
    "Black Screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schwarzer Bildschirm" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écran noir" } }
      }
    },
    "Cancel" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abbrechen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Annuler" } }
      }
    },
    "Check that the file is in the place the PDF expects, relative to the PDF." : {
      "comment" : "Message when a run: link target is missing",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe, ob die Datei dort liegt, wo das PDF sie erwartet (relativ zum PDF)." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifiez que le fichier se trouve à l’emplacement attendu par le PDF, relativement au PDF." } }
      }
    },
    "Choose the folder that contains the PDF and its videos." : {
      "comment" : "Message of the folder picker for the PDF's folder",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle den Ordner, der das PDF und seine Videos enthält." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez le dossier qui contient le PDF et ses vidéos." } }
      }
    },
    "Clock" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Uhr" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Horloge" } }
      }
    },
    "Arrangement" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Anordnung" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Disposition" } }
      }
    },
    "Connect a display, or start Screen Mirroring in Control Center." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schließe einen Bildschirm an oder starte „Bildschirmsynchronisierung“ im Kontrollzentrum." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez un écran ou lancez « Recopie de l’écran » dans le centre de contrôle." } }
      }
    },
    "Connected" : {
      "comment" : "Accessibility value of the external display button; status of a remote device",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbunden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecté" } }
      }
    },
    "Cover the presentation with a black screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Präsentation mit einem schwarzen Bildschirm verdecken" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Couvrir la présentation d'un écran noir" } }
      }
    },
    "Cover the presentation with a white screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Präsentation mit einem weißen Bildschirm verdecken" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Couvrir la présentation d'un écran blanc" } }
      }
    },
    "Current slide, %lld of %lld" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktuelle Folie, %1$lld von %2$lld" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive actuelle, %1$lld sur %2$lld" } }
      }
    },
    "Don’t Use" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht verwenden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ne pas utiliser" } }
      }
    },
    "End of presentation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ende der Präsentation" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fin de la présentation" } }
      }
    },
    "Crossfade slides" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Folien überblenden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fondu entre les diapositives" } }
      }
    },
    "General" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Allgemein" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Général" } }
      }
    },
    "Keep display awake" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bildschirm wach halten" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Garder l’écran allumé" } }
      }
    },
    "Links in a PDF can open documents and videos, but not programs or scripts." : {
      "comment" : "Message when a run: link points to a program or script",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Links in einem PDF können Dokumente und Videos öffnen, aber keine Programme oder Skripte." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les liens d’un PDF peuvent ouvrir des documents et des vidéos, mais pas des programmes ni des scripts." } }
      }
    },
    "Not Now" : {
      "comment" : "Alert button that declines folder access for now",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht jetzt" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plus tard" } }
      }
    },
    "Open file %@" : {
      "comment" : "VoiceOver action of a run: link on a slide; the argument is the file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Datei %@ öffnen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir le fichier %@" } }
      }
    },
    "Settings" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages" } }
      }
    },
    "Settings…" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages…" } }
      }
    },
    "SlidePilot does not open “%@”." : {
      "comment" : "Alert title when a run: link points to a program or script; the argument is the file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "SlidePilot öffnet „%@“ nicht." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "SlidePilot n’ouvre pas « %@ »." } }
      }
    },
    "SlidePilot needs access to the folder of this PDF to play “%@”." : {
      "comment" : "Help tag of the button over a video; the argument is the video's file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "SlidePilot benötigt Zugriff auf den Ordner dieses PDFs, um „%@“ abzuspielen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "SlidePilot a besoin d’accéder au dossier de ce PDF pour lire « %@ »." } }
      }
    },
    "Slides fade into each other on the presentation screen." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Folien gehen auf dem Präsentationsbildschirm ineinander über." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les diapositives se fondent les unes dans les autres sur l’écran de présentation." } }
      }
    },
    "The display does not dim or sleep while SlidePilot is open." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Bildschirm wird nicht abgedunkelt und schläft nicht ein, solange SlidePilot geöffnet ist." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’écran ne s’assombrit pas et ne se met pas en veille tant que SlidePilot est ouvert." } }
      }
    },
    "External Display" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Externer Bildschirm" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écran externe" } }
      }
    },
    "Go Back" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurück" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revenir" } }
