      }
    },
    "The pairing was cancelled. To pair, open Settings ▸ Remote on both devices and confirm the code on both." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Koppeln wurde abgebrochen. Öffne zum Koppeln auf beiden Geräten Einstellungen ▸ Remote und bestätige den Code auf beiden." } },
