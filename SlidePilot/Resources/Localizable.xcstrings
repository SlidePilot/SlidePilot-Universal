    "SlidePilot needs access to the folder of this PDF to play “%@”." : {
      "comment" : "Help tag of the button over a video; the argument is the video's file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "SlidePilot benötigt Zugriff auf den Ordner dieses PDFs, um „%@“ abzuspielen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "SlidePilot a besoin d’accéder au dossier de ce PDF pour lire « %@ »." } }
      }
    },
    "The file “%@” could not be found." : {
      "comment" : "Alert title when a run: link target is missing; the argument is the file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei „%@“ wurde nicht gefunden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le fichier « %@ » est introuvable." } }
      }
    },
    "This PDF contains videos or links to files next to it. To play and open them, choose the folder that contains the PDF. SlidePilot remembers it for all PDFs in that folder." : {
      "comment" : "Message of the alert that asks for access to the PDF's folder",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses PDF enthält Videos oder Links auf Dateien neben dem PDF. Wähle den Ordner mit dem PDF, damit SlidePilot sie abspielen und öffnen kann. SlidePilot merkt sich den Ordner für alle PDFs darin." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce PDF contient des vidéos ou des liens vers des fichiers situés à côté. Pour les lire et les ouvrir, choisissez le dossier qui contient le PDF. SlidePilot s’en souvient pour tous les PDF de ce dossier." } }
      }
    },
    "Video %@" : {
      "comment" : "VoiceOver label of a video player on a slide; the argument is the file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Video %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vidéo %@" } }
      }
    },
    "Video “%@” not found" : {
      "comment" : "Shown over a video on the current slide when its file is missing; the argument is the file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Video „%@“ nicht gefunden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vidéo « %@ » introuvable" } }
      }
    },
    "Stored Document Data…" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gespeicherte Dokumentdaten …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Données des documents enregistrées…" } }
      }
    },
    "Stored Document Data" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gespeicherte Dokumentdaten" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Données des documents enregistrées" } }
      }
    },
    "Notes and settings of your PDFs stay stored when a PDF is deleted. Review and delete them here." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Notizen und Einstellungen deiner PDFs bleiben gespeichert, wenn ein PDF gelöscht wird. Hier kannst du sie ansehen und löschen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les notes et réglages de vos PDF restent enregistrés lorsqu’un PDF est supprimé. Consultez-les et supprimez-les ici." } }
      }
    },
    "Delete…" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löschen …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer…" } }
      }
    },
    "Delete" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löschen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer" } }
      }
    },
    "To keep notes, open the PDF and choose File ▸ Export Notes… before deleting its data." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Um Notizen zu behalten, öffne das PDF und wähle Ablage ▸ Notizen exportieren …, bevor du seine Daten löschst." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour conserver les notes, ouvrez le PDF et choisissez Fichier ▸ Exporter les notes… avant de supprimer ses données." } }
      }
    },
    "No Stored Data" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine gespeicherten Daten" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune donnée enregistrée" } }
      }
    },
    "Notes and settings of the PDFs you open appear here." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Notizen und Einstellungen der PDFs, die du öffnest, erscheinen hier." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les notes et réglages des PDF que vous ouvrez apparaissent ici." } }
      }
    },
    "Delete Not Found…" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht gefundene löschen …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer les introuvables…" } }
      }
    },
    "The notes and settings that SlidePilot stores are deleted. This can’t be undone." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die von SlidePilot gespeicherten Notizen und Einstellungen werden gelöscht. Das kann nicht widerrufen werden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les notes et réglages enregistrés par SlidePilot sont supprimés. Cette action est irréversible." } }
      }
    },
    "These PDFs may have been deleted, or they are on a drive that isn’t connected or in iCloud and not downloaded. Their notes and settings are deleted. This can’t be undone." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese PDFs wurden vielleicht gelöscht oder liegen auf einem nicht verbundenen Laufwerk oder nicht geladen in iCloud. Ihre Notizen und Einstellungen werden gelöscht. Das kann nicht widerrufen werden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces PDF ont peut-être été supprimés, ou se trouvent sur un disque non connecté ou dans iCloud sans être téléchargés. Leurs notes et réglages sont supprimés. Cette action est irréversible." } }
      }
    },
    "Delete the Data of “%@”?" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Daten von „%@“ löschen?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer les données de « %@ » ?" } }
      }
    },
    "Delete the Data of the Selected PDFs?" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Daten der ausgewählten PDFs löschen?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer les données des PDF sélectionnés ?" } }
      }
    },
    "Last opened %@" : {
