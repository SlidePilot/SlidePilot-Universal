        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nächste Folie, %1$lld von %2$lld" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive suivante, %1$lld sur %2$lld" } }
