    },
    "Notes Can’t Be Shown" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Notizen können nicht angezeigt werden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible d’afficher les notes" } }
      }
    },
    "Smaller" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kleiner" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plus petit" } }
      }
    },
    "Spacing…" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abstand …" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Espacement…" } }
      }
    },
    "Text" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Text" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Texte" } }
      }
    },
    "The file “%@” could not be found." : {
      "comment" : "Alert title when a run: link target is missing; the argument is the file name",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei „%@“ wurde nicht gefunden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le fichier « %@ » est introuvable." } }
      }
    },
    "These notes were saved by a newer version of SlidePilot." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Notizen wurden mit einer neueren Version von SlidePilot gesichert." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces notes ont été enregistrées avec une version plus récente de SlidePilot." } }
      }
    },
    "This PDF contains videos or links to files next to it. To play and open them, choose the folder that contains the PDF. SlidePilot remembers it for all PDFs in that folder." : {
      "comment" : "Message of the alert that asks for access to the PDF's folder",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses PDF enthält Videos oder Links auf Dateien neben dem PDF. Wähle den Ordner mit dem PDF, damit SlidePilot sie abspielen und öffnen kann. SlidePilot merkt sich den Ordner für alle PDFs darin." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce PDF contient des vidéos ou des liens vers des fichiers situés à côté. Pour les lire et les ouvrir, choisissez le dossier qui contient le PDF. SlidePilot s’en souvient pour tous les PDF de ce dossier." } }
      }
    },
    "Underline" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Unterstrichen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Souligné" } }
      }
    },
    "Page Number" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Seitenzahl" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Numéro de page" } }
      }
    },
    "Overtime %@" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Überzogen %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Dépassement %@" } }
      }
    },
    "Not connected" : {
      "comment" : "Accessibility value of the external display button",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht verbunden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Non connecté" } }
      }
    },
    "Open link %@" : {
      "comment" : "VoiceOver action of a web or mail link on a slide; the argument is the web host or the mail address",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Link %@ öffnen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir le lien %@" } }
      }
    },
    "Present on a second screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf einem zweiten Bildschirm präsentieren" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Présenter sur un second écran" } }
      }
    },
    "Presentation" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Präsentation" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Présentation" } }
      }
    },
    "Presentation, slide %lld of %lld" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Präsentation, Folie %1$lld von %2$lld" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Présentation, diapositive %1$lld sur %2$lld" } }
      }
    },
    "Preview Next Slide" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorschau nächste Folie" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aperçu de la diapositive suivante" } }
      }
    },
    "Previous Slide" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorherige Folie" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Diapositive précédente" } }
      }
    },
    "Ready to present" : {
