    "Finish editing the notes" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bearbeiten der Notizen beenden" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Terminer la modification des notes" } }
      }
