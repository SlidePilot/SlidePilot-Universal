    },
    "The document “%@” could not be opened." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Dokument „%@“ konnte nicht geöffnet werden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le document « %@ » n’a pas pu être ouvert." } }
      }
    },
    "The document could not be opened." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Dokument konnte nicht geöffnet werden." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le document n’a pas pu être ouvert." } }
      }
    },
    "The file is damaged or is not a PDF document." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Datei ist beschädigt oder kein PDF-Dokument." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le fichier est endommagé ou n’est pas un document PDF." } }
      }
    },
    "The PDF does not contain any pages." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das PDF enthält keine Seiten." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le PDF ne contient aucune page." } }
      }
    },
    "The PDF is protected with a password. Remove the password and open it again." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das PDF ist mit einem Passwort geschützt. Entferne das Passwort und öffne es erneut." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le PDF est protégé par un mot de passe. Supprimez le mot de passe et ouvrez-le à nouveau." } }
      }
    }
