      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Gerät im selben Netzwerk, auf dem SlidePilot läuft. Um ein neues Gerät zu koppeln, öffne dort zuerst Einstellungen ▸ Remote und prüfe dann, ob beide Geräte denselben Code zeigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un appareil du même réseau sur lequel SlidePilot est ouvert. Pour jumeler un nouvel appareil, ouvrez d’abord Réglages ▸ Remote sur celui-ci, puis vérifiez que les deux appareils affichent le même code."
          }
