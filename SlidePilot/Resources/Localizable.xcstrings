    "SlidePilot does not open “%@”." : {
      "comment" : "Alert title when a run: link points to a program or script; the argument is the file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlidePilot öffnet „%@“ nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlidePilot n’ouvre pas « %@ »."
          }
        }
      }
    },
    "SlidePilot found the notes file “%@” next to this PDF. To import it, allow SlidePilot to read the PDF’s folder. You only need to do this once per folder. Import Notes… in the File menu stays available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlidePilot hat neben diesem PDF die Notizdatei „%@“ gefunden. Erlaube SlidePilot, den Ordner des PDFs zu lesen, um sie zu importieren. Das ist nur einmal pro Ordner nötig. „Notizen importieren …“ im Menü „Ablage“ bleibt verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlidePilot a trouvé le fichier de notes « %@ » à côté de ce PDF. Pour l’importer, autorisez SlidePilot à lire le dossier du PDF. Cela n’est nécessaire qu’une fois par dossier. « Importer des notes… » reste disponible dans le menu Fichier."
          }
        }
      }
    },
    "SlidePilot needs access to the folder of this PDF to play “%@”." : {
      "comment" : "Help tag of the button over a video; the argument is the video's file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlidePilot benötigt Zugriff auf den Ordner dieses PDFs, um „%@“ abzuspielen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SlidePilot a besoin d’accéder au dossier de ce PDF pour lire « %@ »."
          }
        }
      }
    },
    "Slides fade into each other on the presentation screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Folien gehen auf dem Präsentationsbildschirm ineinander über."
