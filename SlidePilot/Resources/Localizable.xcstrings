    "“%@” does not trust this device any more. Select it again to pair." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ vertraut diesem Gerät nicht mehr. Wähle es erneut aus, um es zu koppeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne fait plus confiance à cet appareil. Sélectionnez-le à nouveau pour le jumeler."
          }
        }
      }
    },
    "“%@” has to be paired again before either device can control the other." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss erneut gekoppelt werden, bevor eines der Geräte das andere steuern kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » doit être de nouveau jumelé avant que l’un des appareils puisse contrôler l’autre."
          }
        }
      }
    },
    "“%@” is also removed from the trusted devices and has to be paired again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird auch aus den vertrauenswürdigen Geräten entfernt und muss erneut gekoppelt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est aussi retiré des appareils de confiance et doit être de nouveau jumelé."
          }
        }
      }
    },
    "“%@” is not a SlidePilot notes file in RTF format." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine SlidePilot-Notizdatei im RTF-Format."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un fichier de notes SlidePilot au format RTF."
          }
        }
      }
    },
    "“%@” removed this device from its trusted devices. Pair again to control it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat dieses Gerät aus seinen vertrauenswürdigen Geräten entfernt. Kopple es erneut, um es zu steuern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a retiré cet appareil de ses appareils de confiance. Jumelez-le à nouveau pour le contrôler."
          }
        }
      }
    },
    "“%@” was closed on “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wurde auf „%2$@“ geschlossen."
