        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appareils à proximité" } }
      }
    },
    "Open SlidePilot on another device on the same network and open Settings ▸ Remote there too. Then connect and check that both devices show the same code." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffne SlidePilot auf einem anderen Gerät im selben Netzwerk und dort ebenfalls Einstellungen ▸ Remote. Verbinde dann die Geräte und prüfe, ob beide denselben Code zeigen." } },
