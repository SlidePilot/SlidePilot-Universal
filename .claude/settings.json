{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git fetch origin *)",
      "Bash(git pull origin *)",
      "Bash(git push -u origin *)",
      "Bash(swift test --disable-sandbox --package-path Packages/*)",
      "Bash(swift build --disable-sandbox --package-path Packages/*)",
      "Bash(xcodebuild -version)",
      "Bash(xcodebuild -project SlidePilot.xcodeproj *)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun simctl boot *)",
      "Bash(xcrun simctl shutdown *)",
      "Bash(xcrun simctl install *)",
      "Bash(xcrun simctl launch *)",
      "Bash(xcrun simctl terminate *)",
      "Bash(xcrun simctl ui *)",
      "Bash(xcrun simctl status_bar *)",
      "Bash(xcrun simctl io * screenshot *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(screencapture *)",
      "Bash(/usr/sbin/screencapture *)",
      "Bash(open *)",
      "Bash(osascript *)",
      "Bash(git -c *)",
      "Bash(git config *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * +*)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh release *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh extension *)",
      "Bash(gh alias *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.cer)",
      "Read(**/*.certSigningRequest)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.provisionprofile)",
      "Read(Config/Local.xcconfig)",
      "Edit(Config/Local.xcconfig)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Application Support/AddressBook/**)",
      "Read(~/Library/Mobile Documents/**)",
      "Read(~/Pictures/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "xcodebuild -version",
      "xcodebuild -project SlidePilot.xcodeproj *",
      "xcrun simctl *",
      "git fetch origin *",
      "git pull origin *",
      "git push -u origin *",
      "gh issue view *",
      "gh issue list *",
      "gh pr view *",
      "gh pr list *",
      "gh pr diff *",
      "gh pr checks *",
      "gh pr create *",
      "gh pr edit *",
      "gh pr ready *",
      "gh run view *",
      "gh run list *",
      "gh run watch *"
    ],
    "network": {
      "allowedDomains": []
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.claude.json",
        "~/.claude",
        "~/Library/Keychains",
        "~/Library/Mail",
        "~/Library/Messages",
        "~/Library/Safari",
        "~/Library/Cookies",
        "~/Library/Application Support/AddressBook",
        "~/Library/Mobile Documents",
        "~/Desktop",
        "~/Documents",
        "~/Downloads",
        "~/Pictures",
        "~/Movies",
        "~/Music"
      ],
      "allowRead": [
        ".",
        "../SlidePilot-macOS"
      ],
      "allowWrite": [
        "~/Library/Caches/org.swift.swiftpm"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}
