// Shared build settings for the SlidePilot app target.
// The bundle ID prefix and the development team are those of the App Store
// app record (ADR 0014). They are public anyway: the team ID is part of every
// signed build and the bundle ID is listed in the App Store. Committing them
// lets Xcode Cloud and fresh checkouts archive without extra setup.
BUNDLE_ID_PREFIX = de.pascalbraband
DEVELOPMENT_TEAM = FFSR8KUJW2

// Product flags. Only the free Mac download shows the donation hint (ADR 0011).
SLIDEPILOT_EDITION_FLAGS =

// Optional, git-ignored overrides, e.g. for a fork signed with its own team
// (see Config/Local.xcconfig.example).
#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).SlidePilot
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(SLIDEPILOT_EDITION_FLAGS)
