// Shared build settings for the SlidePilot app target.
// The bundle ID prefix and the development team are those of the App Store
// app record (ADR 0014). They are public anyway: the team ID is part of every
// signed build and the bundle ID is listed in the App Store. Committing them
// lets Xcode Cloud and fresh checkouts archive without extra setup.
BUNDLE_ID_PREFIX = de.pascalbraband
DEVELOPMENT_TEAM = FFSR8KUJW2

// Product flags. Only the free Mac download shows the donation hint (ADR 0011).
SLIDEPILOT_EDITION_FLAGS =

// Optional, git-ignored overrides, e.g. for a fork signed with its own team
// (see Config/Local.xcconfig.example).
#include? "Local.xcconfig"

// Empty for every real build. The Mac test host build sets ".testhost", so that
// build gets its own container without recents or personal documents (ADR 0018).
SLIDEPILOT_BUNDLE_ID_SUFFIX =

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).SlidePilot$(SLIDEPILOT_BUNDLE_ID_SUFFIX)

// The non-consumable in-app purchase "SlidePilot Pro" (ADR 0020, PRO-02). The app reads it
// from the Info.plist key SlidePilotProProductID; the StoreKit configuration file
// Config/SlidePilot.storekit and App Store Connect use the same ID. The .storekit file
// cannot read build settings: a fork with its own BUNDLE_ID_PREFIX changes the ID there too.
SLIDEPILOT_PRO_PRODUCT_ID = $(BUNDLE_ID_PREFIX).SlidePilot.pro
MARKETING_VERSION = 2.0
CURRENT_PROJECT_VERSION = 1

// Empty for every real build. Debug test builds may set SLIDEPILOT_PRO_UNLOCKED to start
// with Pro unlocked without StoreKit, e.g. for store screenshots through the Mac test host,
// which passes no launch arguments. Release builds ignore it (ProStore checks DEBUG first).
SLIDEPILOT_DEBUG_FLAGS =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(SLIDEPILOT_EDITION_FLAGS) $(SLIDEPILOT_DEBUG_FLAGS)
