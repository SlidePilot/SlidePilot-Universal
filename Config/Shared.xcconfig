// Shared build settings for the SlidePilot app target.
// Real values for the bundle ID prefix and the development team are
// personal data and must not be committed. Put them into the
// git-ignored Config/Local.xcconfig (see Config/Local.xcconfig.example).

// Placeholder defaults: build without signing, e.g. in CI.
BUNDLE_ID_PREFIX = org.example
DEVELOPMENT_TEAM =

// Product flags. Only the free Mac download shows the donation hint (ADR 0011).
SLIDEPILOT_EDITION_FLAGS =

#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).SlidePilot
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(SLIDEPILOT_EDITION_FLAGS)
