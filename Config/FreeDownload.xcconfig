// The free Mac download outside the App Store (ADR 0011), used by the build
// configuration "FreeDownload" and the scheme "SlidePilot Free Download".
// Everything else comes from Shared.xcconfig.
#include "Shared.xcconfig"

// Turns on the donation hint (DROP-03). Only this build sets the flag.
SLIDEPILOT_EDITION_FLAGS = SLIDEPILOT_FREE_DOWNLOAD

// Own bundle ID, so the download never shares settings or the sandbox container
// with the App Store version (ADR 0011).
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).SlidePilot.FreeDownload$(SLIDEPILOT_BUNDLE_ID_SUFFIX)

// Mac only: the iPad app exists in the App Store only.
SUPPORTED_PLATFORMS = macosx
