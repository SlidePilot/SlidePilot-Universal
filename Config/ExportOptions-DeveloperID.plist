<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The free Mac download (ADR 0011): Developer ID signed, notarized by Apple
	     during export. The team and bundle ID come from the archive
	     (Config/FreeDownload.xcconfig), never from this file. -->
	<key>method</key>
	<string>developer-id</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
</dict>
</plist>
